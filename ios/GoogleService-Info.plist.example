<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLACEHOLDER — replace with the real file from Firebase Console.

  Steps:
  1. Firebase Console → Project connectiqo-dff47 → Add app → iOS
  2. Bundle ID: com.connectiqo.app
  3. Download GoogleService-Info.plist
  4. Put it at: ios/GoogleService-Info.plist  (and add to Xcode target MyApp)
  5. Also upload an APNs Auth Key (.p8) under Project Settings → Cloud Messaging → Apple app config

  This placeholder will NOT enable push until replaced.
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>REPLACE_ME.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.REPLACE_ME</string>
	<key>API_KEY</key>
	<string>REPLACE_ME</string>
	<key>GCM_SENDER_ID</key>
	<string>191149851689</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.connectiqo.app</string>
	<key>PROJECT_ID</key>
	<string>connectiqo-dff47</string>
	<key>STORAGE_BUCKET</key>
	<string>connectiqo-dff47.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>1:191149851689:ios:REPLACE_ME</string>
</dict>
</plist>
